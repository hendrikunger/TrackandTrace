# Central application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8081
UI_HOST=127.0.0.1
UI_PORT=8080
UI_AUTORELOAD=true
# Comma-separated Bokeh websocket origins for exposed UI hosts, e.g. api.home.io:8080.
UI_WEBSOCKET_ORIGINS=
# Kiosk polling. Scanner poll runs continuously; measurement poll runs only during active requests.
KIOSK_SCANNER_POLL_MS=250
KIOSK_MEASUREMENT_POLL_MS=500
COMPANION_AUTH_REQUIRED=false

# PostgreSQL development database
DATABASE_HOST=10.0.0.70
DATABASE_PORT=5432
DATABASE_NAME=trackandtrace_dev
DATABASE_USER=trackandtrace_admin
DATABASE_PASSWORD=

# Station companion and kiosk bootstrap example
# Kiosk station can also be overridden locally with /kiosk?station_id=1.
STATION_ID=
SERVER_URL=http://localhost:8081
STATION_TOKEN=
COMPANION_OUTBOX_RETRY_INTERVAL_SECONDS=2
