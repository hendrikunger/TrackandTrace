#!/usr/bin/env bash
set -euo pipefail

ENV_FILE="${ENV_FILE:-/etc/slf-trace/kiosk.env}"

if [[ -r "$ENV_FILE" ]]; then
  set -a
  # shellcheck disable=SC1090
  source "$ENV_FILE"
  set +a
elif [[ -r /etc/slf-trace/panel.env ]]; then
  set -a
  # shellcheck disable=SC1091
  source /etc/slf-trace/panel.env
  set +a
fi

UI_HOST="${UI_HOST:-127.0.0.1}"
UI_PORT="${UI_PORT:-8080}"
STATION_ID="${STATION_ID:-1}"
KIOSK_BASE_URL="${KIOSK_BASE_URL:-http://${UI_HOST}:${UI_PORT}}"
KIOSK_URL="${KIOSK_URL:-${KIOSK_BASE_URL}/kiosk?station_id=${STATION_ID}}"

if command -v gsettings >/dev/null 2>&1; then
  gsettings set org.gnome.desktop.session idle-delay 0 >/dev/null 2>&1 || true
  gsettings set org.gnome.desktop.screensaver lock-enabled false >/dev/null 2>&1 || true
  gsettings set org.gnome.desktop.screensaver idle-activation-enabled false >/dev/null 2>&1 || true
  gsettings set org.gnome.settings-daemon.plugins.power sleep-inactive-ac-type 'nothing' >/dev/null 2>&1 || true
  gsettings set org.gnome.settings-daemon.plugins.power sleep-inactive-battery-type 'nothing' >/dev/null 2>&1 || true
fi

wait_for_ui() {
  for _ in $(seq 1 120); do
    if curl -fsS "$KIOSK_URL" >/dev/null 2>&1; then
      return 0
    fi
    sleep 1
  done
  return 1
}

wait_for_ui || true

if command -v chromium >/dev/null 2>&1; then
  exec chromium --kiosk --no-first-run --disable-infobars "$KIOSK_URL"
fi

if command -v chromium-browser >/dev/null 2>&1; then
  exec chromium-browser --kiosk --no-first-run --disable-infobars "$KIOSK_URL"
fi

if command -v google-chrome >/dev/null 2>&1; then
  exec google-chrome --kiosk --no-first-run --disable-infobars "$KIOSK_URL"
fi

if command -v firefox >/dev/null 2>&1; then
  exec firefox --kiosk "$KIOSK_URL"
fi

echo "No supported kiosk browser found. Install Firefox, Chromium, or Chrome." >&2
exit 1
