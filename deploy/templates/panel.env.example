APP_ENV=production

UI_HOST=127.0.0.1
UI_PORT=8080
UI_AUTORELOAD=false
UI_WEBSOCKET_ORIGINS=

DATABASE_HOST=server-hostname-or-ip
DATABASE_PORT=5432
DATABASE_NAME=trackandtrace
DATABASE_USER=trackandtrace_admin
DATABASE_PASSWORD=change-me

# Used by the companion and by the kiosk UI. Local development can override the kiosk station with
# http://127.0.0.1:8080/kiosk?station_id=1.
STATION_ID=1
SERVER_URL=http://server-hostname-or-ip:8081
STATION_TOKEN=
COMPANION_STATE_PATH=state/companion_state.sqlite3
COMPANION_LOG_PATH=logs/slf-trace-companion.log
COMPANION_LOG_MAX_BYTES=5000000
COMPANION_LOG_BACKUP_COUNT=5

# Optional SMB adapter credentials referenced by station adapter config.
SMB_USER=
SMB_PASSWORD=
